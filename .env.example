# Copy to .env, supply cloud API keys, then run docker compose up.
# .env is ignored by Git and excluded from image builds.
AVE_VISION_API_KEY=
AVE_PLANNER_API_KEY=
AVE_BROWSER_PORT=6080
AVE_WHISPER_DEVICE=auto
COMPOSE_FILE=compose.yaml
COMPOSE_PATH_SEPARATOR=|
# NVIDIA hosts: COMPOSE_FILE=compose.yaml|docker/compose.gpu.yaml
# AVE_MATERIALS=./materials
# AVE_EXPORTS=./exports
