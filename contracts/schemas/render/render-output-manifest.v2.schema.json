{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/render/render-output-manifest.v2.json",
  "title": "RenderOutputManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "render_id", "target", "semantic_graph_hash", "execution_plan_id", "cache_key", "output_hash", "worker_version", "backend_version", "diagnostics"],
  "properties": {
    "schema_version": { "const": 2 },
    "render_id": { "type": "string", "minLength": 1 },
    "target": { "enum": ["preview", "master"] },
    "semantic_graph_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "execution_plan_id": { "type": "string", "minLength": 1 },
    "cache_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "output_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "worker_version": { "type": "string", "minLength": 1 },
    "backend_version": { "type": "string", "minLength": 1 },
    "diagnostics": { "type": "array", "items": { "$ref": "https://ai-vlog.local/contracts/render/render-diagnostic.v1.json" } },
    "audio_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "normalized" } }, "required": ["status"] },
          "then": { "properties": { "input_integrated_lufs": {}, "input_true_peak_db": {}, "output_integrated_lufs": {}, "output_true_peak_db": {}, "target_lufs": {}, "true_peak_ceiling_db": {}, "tolerance_lufs": {}, "within_tolerance": {} }, "required": ["input_integrated_lufs", "input_true_peak_db", "output_integrated_lufs", "output_true_peak_db", "target_lufs", "true_peak_ceiling_db", "tolerance_lufs", "within_tolerance"] }
        }
      ],
      "properties": {
        "status": { "enum": ["normalized", "disabled", "no_audio"] },
        "input_integrated_lufs": { "type": "number" },
        "input_true_peak_db": { "type": "number" },
        "output_integrated_lufs": { "type": "number" },
        "output_true_peak_db": { "type": "number" },
        "target_lufs": { "type": "number" },
        "true_peak_ceiling_db": { "type": "number" },
        "tolerance_lufs": { "type": "number" },
        "within_tolerance": { "type": "boolean" }
      }
    }
  }
}
