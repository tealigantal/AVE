{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/project/workspace-issue.v1.json",
  "title": "WorkspaceIssueV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "project_id", "revision", "operation_id", "operation_type", "code", "message", "subject", "preserved", "recovery", "status", "count", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "issue_id": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "project_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "operation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "operation_type": { "type": "string", "minLength": 1, "maxLength": 160 },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,99}$" },
    "message": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label"],
      "properties": {
        "kind": { "enum": ["project", "asset", "request", "version"] },
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "preserved": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "recovery": { "enum": ["retry", "choose-source", "reopen-project", "free-space", "check-permission", "view-details"] },
    "status": { "enum": ["open", "resolved", "dismissed"] },
    "count": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "minLength": 20, "maxLength": 30 },
    "updated_at": { "type": "string", "minLength": 20, "maxLength": 30 }
  }
}
