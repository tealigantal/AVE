{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/worker/media-sample-request.v1.json",
  "title": "MediaSampleRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_type",
    "input_path",
    "source_digest",
    "stream_index",
    "samples",
    "output_dir",
    "max_frame_edge",
    "timeout_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_type": {
      "const": "media.sample.v1"
    },
    "input_path": {
      "type": "string",
      "minLength": 1
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stream_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "kind",
          "start",
          "end"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "kind": {
            "enum": [
              "frame",
              "audio"
            ]
          },
          "start": {
            "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
          },
          "end": {
            "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
          }
        }
      }
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    },
    "max_frame_edge": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
