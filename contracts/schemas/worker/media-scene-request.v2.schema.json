{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/worker/media-scene-request.v2.json",
  "title": "MediaSceneRequestV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_type",
    "input_path",
    "source_digest",
    "stream_index",
    "threshold",
    "timeout_seconds",
    "output_dir"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "task_type": {
      "const": "media.scene_scan.v2"
    },
    "input_path": {
      "type": "string",
      "minLength": 1
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stream_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "threshold": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    }
  }
}
