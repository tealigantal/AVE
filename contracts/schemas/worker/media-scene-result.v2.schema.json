{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/worker/media-scene-result.v2.json",
  "title": "MediaSceneResultV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "path",
    "receipt",
    "span_count"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "header",
        "frame_count",
        "start_pts",
        "end_pts",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "header": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "source_digest",
            "stream_index",
            "time_base",
            "threshold",
            "policy_version",
            "ffmpeg_version"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "source_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "stream_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "time_base": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "numerator",
                "denominator"
              ],
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            },
            "threshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "policy_version": {
              "const": "decoded-pixel-change-v1"
            },
            "ffmpeg_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "start_pts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_pts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "span_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
