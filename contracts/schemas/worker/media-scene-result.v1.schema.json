{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/worker/media-scene-result.v1.json",
  "title": "MediaSceneResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_digest",
    "stream_index",
    "time_base",
    "start_pts",
    "end_pts",
    "frames",
    "spans",
    "threshold",
    "policy_version",
    "ffmpeg_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stream_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "time_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "start_pts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "end_pts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame_index",
          "pts",
          "end_pts",
          "change_score"
        ],
        "properties": {
          "frame_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "pts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end_pts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "change_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "minItems": 1
    },
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "span_index",
          "first_frame_index",
          "last_frame_index",
          "start_pts",
          "end_pts"
        ],
        "properties": {
          "span_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "first_frame_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "last_frame_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "start_pts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end_pts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "minItems": 1
    },
    "threshold": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "policy_version": {
      "const": "decoded-pixel-change-v1"
    },
    "ffmpeg_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
