{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/feedback-diagnosis.v2.json",
  "title": "FeedbackDiagnosisV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagnosis_id", "object_version", "status", "category", "feedback", "base_execution_ref", "base_timeline_ref", "target", "authority_refs", "affected_scope", "reason", "alternatives", "confidence", "input_fingerprint", "created_at", "provenance"],
  "properties": {
    "schema_version": { "const": 2 },
    "diagnosis_id": { "type": "string", "minLength": 1 },
    "object_version": { "const": 1 },
    "status": { "const": "reviewed" },
    "category": { "const": "pacing" },
    "feedback": { "type": "object", "additionalProperties": false, "required": ["text", "digest"], "properties": { "text": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "base_execution_ref": { "$ref": "#/$defs/ref" },
    "base_timeline_ref": { "type": "object", "additionalProperties": false, "required": ["version", "digest"], "properties": { "version": { "type": "integer", "minimum": 1 }, "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "clip_id", "original_source", "proposed_source", "operation"],
      "properties": {
        "track_id": { "type": "string", "minLength": 1 },
        "clip_id": { "type": "string", "minLength": 1 },
        "original_source": { "$ref": "#/$defs/source_range" },
        "proposed_source": { "$ref": "#/$defs/source_range" },
        "operation": { "const": "trim_semantic_range" }
      }
    },
    "authority_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_story_ref", "decision_refs", "evidence_refs", "contract_ref", "capability_snapshot_ref"],
      "properties": {
        "approved_story_ref": { "$ref": "#/$defs/ref" },
        "decision_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "contract_ref": { "$ref": "#/$defs/ref" },
        "capability_snapshot_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "affected_scope": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^clip:.+" } },
    "reason": { "type": "string", "minLength": 1 },
    "alternatives": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "confidence": { "type": "object", "additionalProperties": false, "required": ["score", "basis"], "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "basis": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
    "input_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "$ref": "#/$defs/date" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["producer", "source_version", "policy_version", "input_refs"], "properties": { "producer": { "const": "project-host" }, "source_version": { "type": "string", "minLength": 1 }, "policy_version": { "type": "string", "minLength": 1 }, "input_refs": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } }
  },
  "$defs": {
    "ref": { "type": "object", "additionalProperties": false, "required": ["object_id", "object_version", "digest"], "properties": { "object_id": { "type": "string", "minLength": 1 }, "object_version": { "type": "integer", "minimum": 1 }, "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "source_range": { "type": "object", "additionalProperties": false, "required": ["asset_id", "start", "end"], "properties": { "asset_id": { "type": "string", "pattern": "^asset:sha256:[0-9a-f]{64}$" }, "start": { "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json" }, "end": { "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json" } } },
    "date": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$" }
  }
}
