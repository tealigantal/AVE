{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/audio-resource-pack.v1.json",
  "title": "AudioResourcePackV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "curation_version",
    "audited_at",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pack_id": {
      "const": "ave-free-audio"
    },
    "pack_version": {
      "type": "string",
      "minLength": 1
    },
    "curation_version": {
      "const": 1
    },
    "audited_at": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "minItems": 120,
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "resource_version",
          "kind",
          "title",
          "author",
          "source_page",
          "license",
          "download",
          "content_sha256",
          "byte_length",
          "measurement",
          "source_tags",
          "use_tags",
          "curation_note",
          "bpm",
          "vocals",
          "loop_points"
        ],
        "properties": {
          "resource_id": {
            "type": "string",
            "pattern": "^(oga|kenney):[a-f0-9]{16}$"
          },
          "resource_version": {
            "const": 1
          },
          "kind": {
            "enum": [
              "music",
              "sfx"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "source_page": {
            "type": "string",
            "pattern": "^https://(opengameart\\.org|kenney\\.nl)/"
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "spdx",
              "version",
              "url",
              "attribution_required",
              "verified_at",
              "source_page_sha256",
              "license_evidence_sha256"
            ],
            "properties": {
              "spdx": {
                "enum": [
                  "CC0-1.0",
                  "CC-BY-4.0",
                  "CC-BY-3.0"
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://creativecommons\\.org/"
              },
              "attribution_required": {
                "type": "boolean"
              },
              "verified_at": {
                "type": "string",
                "format": "date"
              },
              "source_page_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "license_evidence_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "spdx": {
                      "const": "CC0-1.0"
                    }
                  },
                  "required": [
                    "spdx"
                  ]
                },
                "then": {
                  "properties": {
                    "version": {
                      "const": "1.0"
                    },
                    "url": {
                      "const": "https://creativecommons.org/publicdomain/zero/1.0/"
                    },
                    "attribution_required": {
                      "const": false
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "spdx": {
                      "const": "CC-BY-4.0"
                    }
                  },
                  "required": [
                    "spdx"
                  ]
                },
                "then": {
                  "properties": {
                    "version": {
                      "const": "4.0"
                    },
                    "url": {
                      "const": "https://creativecommons.org/licenses/by/4.0/"
                    },
                    "attribution_required": {
                      "const": true
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "spdx": {
                      "const": "CC-BY-3.0"
                    }
                  },
                  "required": [
                    "spdx"
                  ]
                },
                "then": {
                  "properties": {
                    "version": {
                      "const": "3.0"
                    },
                    "url": {
                      "const": "https://creativecommons.org/licenses/by/3.0/"
                    },
                    "attribution_required": {
                      "const": true
                    }
                  }
                }
              }
            ]
          },
          "download": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "url"
                ],
                "properties": {
                  "kind": {
                    "const": "direct"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://(opengameart\\.org|kenney\\.nl)/"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "url",
                  "member_name",
                  "range_start",
                  "range_end",
                  "archive_byte_length",
                  "archive_sha256",
                  "compression",
                  "compressed_bytes"
                ],
                "properties": {
                  "kind": {
                    "const": "archive_range"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://(opengameart\\.org|kenney\\.nl)/"
                  },
                  "member_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "range_start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "range_end": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "archive_byte_length": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 33554432
                  },
                  "archive_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "compression": {
                    "const": "deflate"
                  },
                  "compressed_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 33554432
                  }
                }
              }
            ]
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          },
          "measurement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "display_length_seconds",
              "sample_rate",
              "channels",
              "waveform",
              "waveform_method"
            ],
            "properties": {
              "display_length_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1800
              },
              "sample_rate": {
                "type": "integer",
                "minimum": 8000,
                "maximum": 192000
              },
              "channels": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "waveform": {
                "type": "array",
                "minItems": 64,
                "maxItems": 64,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "waveform_method": {
                "const": "ffmpeg-decode-mono-8000hz-peak64-v1"
              }
            }
          },
          "source_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "use_tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "daily",
                "travel",
                "warm",
                "upbeat",
                "quiet",
                "city",
                "hint",
                "motion",
                "transition",
                "emphasis",
                "environment"
              ]
            }
          },
          "curation_note": {
            "type": "string",
            "minLength": 1
          },
          "bpm": {
            "type": "null"
          },
          "vocals": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "loop_points": {
            "type": "array",
            "maxItems": 0
          },
          "source_timing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time_base",
              "start_pts",
              "duration_ts"
            ],
            "properties": {
              "time_base": {
                "type": "string",
                "minLength": 1
              },
              "start_pts": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "duration_ts": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "pack_version",
        "pack_digest",
        "mode"
      ],
      "properties": {
        "pack_id": {
          "const": "ave-free-audio"
        },
        "pack_version": {
          "type": "string",
          "minLength": 1
        },
        "pack_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mode": {
          "const": "manual"
        }
      }
    },
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "pack_version",
        "pack_digest",
        "resource_id",
        "content_sha256",
        "kind",
        "metadata_digest"
      ],
      "properties": {
        "pack_id": {
          "const": "ave-free-audio"
        },
        "pack_version": {
          "type": "string",
          "minLength": 1
        },
        "pack_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resource_id": {
          "type": "string",
          "pattern": "^(oga|kenney):[a-f0-9]{16}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "music",
            "sfx"
          ]
        },
        "metadata_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
