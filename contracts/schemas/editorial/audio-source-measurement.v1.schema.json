{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/audio-source-measurement.v1.json",
  "title": "AudioSourceMeasurementV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "request_id",
    "run_id",
    "revision",
    "base_timeline_version",
    "root_input_digest",
    "query_output_hash",
    "authorization_digest",
    "authorization_generation",
    "cancellation_generation",
    "resource_ref",
    "resource_snapshot",
    "material_ref",
    "probe_ref",
    "sample_ref",
    "sample_receipt",
    "source_start",
    "source_end",
    "stream_index",
    "sample_rate",
    "channels",
    "selection_reason",
    "match_evidence_ids",
    "origin"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "base_timeline_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "root_input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "query_output_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cancellation_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resource_ref": {
      "$ref": "https://ai-vlog.local/contracts/editorial/audio-resource-pack.v1.json#/$defs/resource_ref"
    },
    "resource_snapshot": {
      "$ref": "https://ai-vlog.local/contracts/editorial/audio-resource-pack.v1.json#/properties/items/items"
    },
    "material_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "digest"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "probe_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_ref_id",
        "digest"
      ],
      "properties": {
        "object_ref_id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sample_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_ref_id",
        "digest"
      ],
      "properties": {
        "object_ref_id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sample_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sample_id",
        "source_digest",
        "stream_index",
        "requested_start",
        "requested_end",
        "actual_start",
        "actual_end",
        "content_digest",
        "byte_length",
        "policy_version",
        "ffmpeg_version",
        "detail"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "sample_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stream_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requested_start": {
          "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
        },
        "requested_end": {
          "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
        },
        "actual_start": {
          "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
        },
        "actual_end": {
          "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policy_version": {
          "const": "source-pts-sampling-v1"
        },
        "ffmpeg_version": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sample_rate",
            "channels",
            "sample_count",
            "mime_type"
          ],
          "properties": {
            "kind": {
              "const": "audio"
            },
            "sample_rate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "channels": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "sample_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "mime_type": {
              "const": "audio/wav"
            }
          }
        }
      }
    },
    "source_start": {
      "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
    },
    "source_end": {
      "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
    },
    "stream_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 8000,
      "maximum": 192000
    },
    "channels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "selection_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "match_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "origin": {
      "enum": [
        "automatic",
        "manual"
      ]
    }
  }
}
