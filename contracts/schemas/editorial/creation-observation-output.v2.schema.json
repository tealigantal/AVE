{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/creation-observation-output.v2.json",
  "title": "CreationObservationOutputV2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "samples"],
  "properties": {
    "schema_version": {"const": 2},
    "samples": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_id", "description", "uncertain", "transcript", "events"],
      "properties": {
        "sample_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "uncertain": {"type": "boolean"},
        "transcript": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["start", "end", "text"],
          "properties": {
            "start": {"$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"},
            "end": {"$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"},
            "text": {"type": "string", "minLength": 1},
            "uncertain": {"type": "boolean"}
          }
        }},
        "events": {"type": "array", "maxItems": 128, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "start", "end", "uncertain", "description"],
          "properties": {
            "kind": {"enum": ["ambient", "speech", "music", "silence", "unknown"]},
            "start": {"$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"},
            "end": {"$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"},
            "uncertain": {"type": "boolean"},
            "description": {"type": "string", "minLength": 1}
          }
        }}
      }
    }}
  }
}
