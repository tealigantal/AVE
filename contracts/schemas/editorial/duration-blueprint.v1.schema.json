{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/duration-blueprint.v1.json",
  "title": "DurationBlueprintV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "blueprint_id", "blueprint_version", "definition_digest", "status", "duration_class", "objective", "target_duration", "acceptable_variance", "beat_count", "information_density", "redundancy_policy", "beat_roles", "emotional_curve", "ending_contract", "created_at", "provenance", "governance"],
  "properties": {
    "schema_version": { "const": 1 },
    "blueprint_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "blueprint_version": { "type": "integer", "minimum": 1 },
    "definition_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["published", "retired"] },
    "duration_class": { "enum": ["30s", "60s", "2m", "5m", "10m", "30m"] },
    "objective": { "type": "string", "minLength": 1 },
    "target_duration": { "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json" },
    "acceptable_variance": { "$ref": "#/$defs/nonnegative_time" },
    "beat_count": { "type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": { "minimum": { "type": "integer", "minimum": 1 }, "maximum": { "type": "integer", "minimum": 1 } } },
    "information_density": { "enum": ["very-high", "high", "alternating", "layered", "documentary"] },
    "redundancy_policy": { "enum": ["none", "meaning-only", "callbacks-only"] },
    "beat_roles": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/beat_role" } },
    "emotional_curve": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/curve_point" } },
    "ending_contract": { "type": "object", "additionalProperties": false, "required": ["objective", "reserve", "minimum_evidence_count"], "properties": { "objective": { "type": "string", "minLength": 1 }, "reserve": { "$ref": "#/$defs/nonnegative_time" }, "minimum_evidence_count": { "type": "integer", "minimum": 1 } } },
    "created_at": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["producer", "source_id", "source_version", "policy_version"], "properties": { "producer": { "const": "curated-author" }, "source_id": { "type": "string", "minLength": 1 }, "source_version": { "type": "string", "minLength": 1 }, "policy_version": { "type": "string", "minLength": 1 } } },
    "governance": { "type": "object", "additionalProperties": false, "required": ["reviewer_id", "reviewed_at", "trust_status"], "properties": { "reviewer_id": { "type": "string", "minLength": 1 }, "reviewed_at": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$" }, "trust_status": { "enum": ["trusted", "revoked"] } } }
  },
  "$defs": {
    "beat_role": { "type": "object", "additionalProperties": false, "required": ["role_id", "minimum_duration", "maximum_duration", "minimum_evidence_count"], "properties": { "role_id": { "type": "string", "minLength": 1 }, "minimum_duration": { "$ref": "#/$defs/nonnegative_time" }, "maximum_duration": { "$ref": "#/$defs/nonnegative_time" }, "minimum_evidence_count": { "type": "integer", "minimum": 1 } } },
    "nonnegative_time": { "type": "object", "additionalProperties": false, "required": ["schema_version", "value", "timescale"], "properties": { "schema_version": { "const": 1 }, "value": { "type": "integer", "minimum": 0 }, "timescale": { "type": "integer", "minimum": 1 } } },
    "curve_point": { "type": "object", "additionalProperties": false, "required": ["phase", "position", "intensity"], "properties": { "phase": { "type": "string", "minLength": 1 }, "position": { "type": "number", "minimum": 0, "maximum": 1 }, "intensity": { "type": "number", "minimum": 0, "maximum": 1 } } }
  }
}
