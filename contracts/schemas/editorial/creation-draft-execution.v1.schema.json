{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "draft",
    "source",
    "source_refs",
    "render_profile",
    "preview_plan_id",
    "master_plan_id",
    "semantic_graph_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "draft": {
      "$ref": "https://ai-vlog.local/contracts/editorial/creation-session.v1.json#/$defs/draft"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ticket",
            "plan",
            "observation_refs"
          ],
          "properties": {
            "kind": {
              "const": "model"
            },
            "ticket": {
              "$ref": "https://ai-vlog.local/contracts/editorial/creation-session.v1.json#/$defs/ticket"
            },
            "plan": {
              "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json"
            },
            "observation_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "run_id",
                  "digest"
                ],
                "properties": {
                  "run_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "input_json",
            "authorization_digest",
            "authorization_generation",
            "cancellation_generation"
          ],
          "properties": {
            "kind": {
              "const": "manual"
            },
            "input_json": {
              "type": "string",
              "minLength": 1
            },
            "authorization_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "authorization_generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cancellation_generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "source_track_retention": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "asset_id",
                "material_operation_id",
                "material_digest",
                "fresh_probe",
                "fresh_probe_digest",
                "boundary"
              ],
              "properties": {
                "version": {
                  "const": 1
                },
                "asset_id": {
                  "type": "string",
                  "pattern": "^asset:sha256:[a-f0-9]{64}$"
                },
                "material_operation_id": {
                  "type": "string",
                  "minLength": 1
                },
                "material_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "fresh_probe": {
                  "type": "object",
                  "required": [
                    "streams",
                    "timing"
                  ],
                  "properties": {
                    "streams": {
                      "type": "array",
                      "minItems": 1
                    },
                    "timing": {
                      "type": "object",
                      "required": [
                        "streams"
                      ],
                      "properties": {
                        "streams": {
                          "type": "object"
                        }
                      }
                    }
                  }
                },
                "fresh_probe_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "boundary": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "version",
                    "asset_id",
                    "byte_length",
                    "stream_index",
                    "start_pts",
                    "end_pts",
                    "time_base",
                    "sample_rate",
                    "sample_count"
                  ],
                  "properties": {
                    "version": {
                      "const": 1
                    },
                    "asset_id": {
                      "type": "string",
                      "pattern": "^asset:sha256:[a-f0-9]{64}$"
                    },
                    "byte_length": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "stream_index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "start_pts": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "end_pts": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "time_base": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "numerator",
                        "denominator"
                      ],
                      "properties": {
                        "numerator": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$"
                        },
                        "denominator": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$"
                        }
                      }
                    },
                    "sample_rate": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    },
                    "sample_count": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_ref",
          "original_ref",
          "original_object_ref",
          "source_timescale",
          "original_timescale",
          "has_audio"
        ],
        "properties": {
          "asset_ref": {
            "type": "string",
            "minLength": 1
          },
          "original_ref": {
            "type": "string",
            "minLength": 1
          },
          "original_object_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_timescale": {
            "type": "string",
            "pattern": "^[1-9][0-9]*n$"
          },
          "original_timescale": {
            "type": "string",
            "pattern": "^[1-9][0-9]*n$"
          },
          "has_audio": {
            "type": "boolean"
          },
          "original_width": {
            "type": "integer",
            "minimum": 1
          },
          "original_height": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "render_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "video_codec": {
          "type": "string",
          "minLength": 1
        },
        "audio_codec": {
          "type": "string",
          "minLength": 1
        },
        "container": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "preview_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "master_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "semantic_graph_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/creation-draft-execution.v1.json",
  "title": "CreationDraftExecutionV1"
}
