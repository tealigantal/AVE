{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/timeline-annotation-message.v3.json",
  "title": "TimelineAnnotationMessageV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "message_id", "project_id", "request_id", "draft_id", "expected_revision", "timeline_version", "conversation_revision", "created_at", "request_text", "preserve_refs", "profile_query", "annotations"],
  "properties": {
    "schema_version": { "const": 3 },
    "operation_id": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "message_id": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "draft_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "expected_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740990 },
    "timeline_version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "conversation_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "created_at": { "type": "string", "format": "date-time" },
    "request_text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "preserve_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "profile_query": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contexts", "except_principle_ids"],
          "properties": {
            "contexts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "except_principle_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "annotations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "https://ai-vlog.local/contracts/editorial/timeline-annotation.v2.json" }
    }
  }
}
