{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/creation-decision.v1.json",
  "title": "CreationDecisionV1",
  "description": "Current model proposal. Weighted source windows explicitly authorize Host allocation; exact windows retain their full interval. This is not an executable CreationPlan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_version",
    "target_duration_ticks",
    "thesis",
    "audio",
    "captions",
    "preserve_refs",
    "applied_principle_ids",
    "feedback_interpretation",
    "change_summary",
    "shots"
  ],
  "properties": {
    "decision_version": {
      "const": 1
    },
    "target_duration_ticks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "thesis": {
      "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json#/properties/thesis"
    },
    "audio": {
      "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json#/properties/audio"
    },
    "captions": {
      "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json#/properties/captions"
    },
    "preserve_refs": {
      "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json#/properties/preserve_refs"
    },
    "applied_principle_ids": {
      "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json#/properties/applied_principle_ids"
    },
    "feedback_interpretation": {
      "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json#/properties/feedback_interpretation"
    },
    "change_summary": {
      "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json#/properties/change_summary"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot_id",
          "purpose",
          "embedded_gain_db",
          "reframe",
          "color",
          "source_window",
          "timing"
        ],
        "properties": {
          "shot_id": {
            "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json#/properties/shots/items/properties/shot_id"
          },
          "purpose": {
            "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json#/properties/shots/items/properties/purpose"
          },
          "embedded_gain_db": {
            "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json#/properties/shots/items/properties/embedded_gain_db"
          },
          "reframe": {
            "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json#/properties/shots/items/properties/reframe"
          },
          "color": {
            "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json#/properties/shots/items/properties/color"
          },
          "source_window": {
            "$ref": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json#/properties/shots/items/properties/source"
          },
          "timing": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "weight"
                ],
                "properties": {
                  "kind": {
                    "const": "weighted"
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "exact"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "duration_ticks"
                ],
                "properties": {
                  "kind": {
                    "const": "still"
                  },
                  "duration_ticks": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_window": {
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "image"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "then": {
              "properties": {
                "timing": {
                  "properties": {
                    "kind": {
                      "const": "still"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "else": {
              "properties": {
                "timing": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "exact",
                        "weighted"
                      ]
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          }
        ]
      }
    },
    "skill_effects": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definition_ref",
          "decision_path",
          "evidence_ids",
          "reason"
        ],
        "properties": {
          "definition_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_id",
              "object_version",
              "digest"
            ],
            "properties": {
              "object_id": {
                "type": "string",
                "minLength": 1
              },
              "object_version": {
                "type": "integer",
                "minimum": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "decision_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/(shots(?:/[0-9]+/(source_window|timing(?:/(kind|weight|duration_ticks))?|embedded_gain_db|reframe|color))?|audio(?:/[0-9]+(?:/(source|offset|gain_db|fade_in|fade_out|role))?)?|captions(?:/[0-9]+(?:/(text|offset|duration|style|audio_anchor))?)?)$"
          },
          "value_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Host-derived identity of the bound decision value. Models omit this field; a supplied false digest is rejected."
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "retained_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_timeline_version",
        "duration_ticks",
        "occupied_ticks",
        "placements"
      ],
      "properties": {
        "base_timeline_version": {
          "type": "integer",
          "minimum": 1
        },
        "duration_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "occupied_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "placements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shot_id",
              "start_ticks",
              "duration_ticks"
            ],
            "properties": {
              "shot_id": {
                "type": "string",
                "minLength": 1
              },
              "start_ticks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "duration_ticks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    }
  }
}
