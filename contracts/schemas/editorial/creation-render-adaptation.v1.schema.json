{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/creation-render-adaptation.v1.json",
  "title": "CreationRenderAdaptationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adaptation_id", "project_id", "request_id", "draft_id", "operation_id", "execution_ref", "timeline_digest", "source_identity_digest", "semantic_graph_hash", "preview_profile", "master_profile", "preview_plan_id", "master_plan_id", "proxies", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "adaptation_id": {"$ref": "#/$defs/id"}, "project_id": {"$ref": "#/$defs/id"}, "request_id": {"$ref": "#/$defs/id"}, "draft_id": {"$ref": "#/$defs/id"}, "operation_id": {"$ref": "#/$defs/id"},
    "execution_ref": {"type": "object", "additionalProperties": false, "required": ["object_id", "object_version", "digest"], "properties": {"object_id": {"$ref": "#/$defs/id"}, "object_version": {"const": 1}, "digest": {"$ref": "#/$defs/hash"}}},
    "timeline_digest": {"$ref": "#/$defs/hash"}, "source_identity_digest": {"$ref": "#/$defs/hash"}, "semantic_graph_hash": {"$ref": "#/$defs/hash"},
    "preview_profile": {"$ref": "https://ai-vlog.local/contracts/editorial/creation-draft-execution.v1.json#/properties/render_profile"},
    "master_profile": {"$ref": "https://ai-vlog.local/contracts/editorial/creation-draft-execution.v1.json#/properties/render_profile"},
    "preview_plan_id": {"$ref": "#/$defs/id"}, "master_plan_id": {"$ref": "#/$defs/id"},
    "proxies": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["asset_ref", "original_object_ref", "original_digest", "material_digest", "proxy_object_ref", "proxy_digest", "byte_length", "width", "height", "kind", "policy", "producer_version", "proxy_map"], "properties": {
      "asset_ref": {"type": "string", "pattern": "^asset:sha256:[a-f0-9]{64}$"}, "original_object_ref": {"$ref": "#/$defs/id"}, "original_digest": {"$ref": "#/$defs/hash"}, "material_digest": {"$ref": "#/$defs/hash"}, "proxy_object_ref": {"$ref": "#/$defs/id"}, "proxy_digest": {"$ref": "#/$defs/hash"}, "byte_length": {"type": "integer", "minimum": 1}, "width": {"type": "integer", "minimum": 1, "maximum": 960}, "height": {"type": "integer", "minimum": 1, "maximum": 960}, "kind": {"enum": ["image", "video"]}, "policy": {"enum": ["still-png-lanczos-v1", "h264-preserved-timestamps-v1"]}, "producer_version": {"type": "string", "minLength": 1},
      "proxy_map": {"type": "object", "additionalProperties": false, "required": ["schema_version", "original_timebase", "proxy_timebase", "segments"], "properties": {"schema_version": {"const": 1}, "original_timebase": {"$ref": "#/$defs/positiveBigint"}, "proxy_timebase": {"$ref": "#/$defs/positiveBigint"}, "segments": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["original_start", "original_end", "proxy_start", "proxy_end"], "properties": {"original_start": {"$ref": "#/$defs/time"}, "original_end": {"$ref": "#/$defs/time"}, "proxy_start": {"$ref": "#/$defs/time"}, "proxy_end": {"$ref": "#/$defs/time"}}}}, "audio": {"type": "object", "additionalProperties": false, "required": ["original_sample_rate", "proxy_sample_rate"], "properties": {"original_sample_rate": {"$ref": "#/$defs/positiveBigint"}, "proxy_sample_rate": {"$ref": "#/$defs/positiveBigint"}}}}}
    }}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"id": {"type": "string", "minLength": 1}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "positiveBigint": {"type": "string", "pattern": "^[1-9][0-9]*n$"}, "time": {"type": "object", "additionalProperties": false, "required": ["value", "timescale"], "properties": {"value": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)n$"}, "timescale": {"$ref": "#/$defs/positiveBigint"}}}}
}
