{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/creation-learning-decision.v1.json",
  "title": "CreationLearningDecisionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "principles",
    "no_inference_reason"
  ],
  "properties": {
    "principles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "statement",
          "contexts",
          "exceptions",
          "evidence_refs"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "narrative",
              "pacing",
              "caption",
              "audio",
              "shot",
              "picture"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "contexts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0
    },
    "no_inference_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "principles": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "no_inference_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "no_inference_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
