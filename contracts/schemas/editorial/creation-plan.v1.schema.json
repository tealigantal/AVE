{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json",
  "title": "CreationPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "request_id",
    "revision",
    "base_timeline_version",
    "input_digest",
    "thesis",
    "shots",
    "audio",
    "captions",
    "preserve_refs",
    "applied_principle_ids",
    "feedback_interpretation",
    "change_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "base_timeline_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "thesis": {
      "type": "string",
      "minLength": 1
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot_id",
          "source",
          "purpose",
          "embedded_gain_db",
          "reframe",
          "color"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset_id",
              "start",
              "end",
              "span_id"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
              },
              "end": {
                "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
              },
              "span_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "embedded_gain_db": {
            "type": "number",
            "minimum": -96,
            "maximum": 12
          },
          "reframe": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "focal_x",
                  "focal_y"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "crop_fill",
                      "contain",
                      "blurred_background"
                    ]
                  },
                  "focal_x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "focal_y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "color": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "exposure",
                  "contrast",
                  "saturation"
                ],
                "properties": {
                  "exposure": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "contrast": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "saturation": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 3
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 1
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audio_id",
          "shot_id",
          "source",
          "offset",
          "role",
          "gain_db",
          "fade_in",
          "fade_out",
          "purpose"
        ],
        "properties": {
          "audio_id": {
            "type": "string",
            "minLength": 1
          },
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset_id",
              "start",
              "end",
              "span_id"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
              },
              "end": {
                "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
              },
              "span_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "offset": {
            "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
          },
          "role": {
            "enum": [
              "dialogue",
              "music",
              "narration"
            ]
          },
          "gain_db": {
            "type": "number",
            "minimum": -96,
            "maximum": 12
          },
          "fade_in": {
            "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
          },
          "fade_out": {
            "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caption_id",
          "shot_id",
          "offset",
          "duration",
          "text",
          "kind",
          "evidence_ids",
          "audio_anchor"
        ],
        "properties": {
          "caption_id": {
            "type": "string",
            "minLength": 1
          },
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
          },
          "duration": {
            "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "verbatim",
              "editorial"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "audio_anchor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "embedded",
                      "audio"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "preserve_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "applied_principle_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "feedback_interpretation": {
      "type": "string",
      "minLength": 1
    },
    "change_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
