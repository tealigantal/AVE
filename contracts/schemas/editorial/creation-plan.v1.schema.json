{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/creation-plan.v1.json",
  "title": "CreationPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "request_id",
    "revision",
    "base_timeline_version",
    "input_digest",
    "thesis",
    "shots",
    "audio",
    "captions",
    "preserve_refs",
    "applied_principle_ids",
    "feedback_interpretation",
    "change_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "base_timeline_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "thesis": {
      "type": "string",
      "minLength": 1
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot_id",
          "source",
          "purpose",
          "embedded_gain_db",
          "reframe",
          "color"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "oneOf": [
              {
                "$ref": "#/$defs/temporalSource"
              },
              {
                "$ref": "#/$defs/imageSource"
              }
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "embedded_gain_db": {
            "type": "number",
            "minimum": -96,
            "maximum": 12
          },
          "reframe": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "focal_x",
                  "focal_y"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "crop_fill",
                      "contain",
                      "blurred_background"
                    ]
                  },
                  "focal_x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "focal_y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "scale",
                  "x",
                  "y"
                ],
                "properties": {
                  "mode": {
                    "const": "static_transform"
                  },
                  "scale": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 2
                  },
                  "x": {
                    "type": "integer",
                    "maximum": 0,
                    "multipleOf": 2
                  },
                  "y": {
                    "type": "integer",
                    "maximum": 0,
                    "multipleOf": 2
                  }
                },
                "description": "Same native canvas. Uniform scale then top-left even-integer-pixel placement. For native width W and height H, W-floor(W*scale) <= x <= 0 and H-floor(H*scale) <= y <= 0. Even positions match the existing 4:2:0 overlay chroma grid; no exposed background."
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "x",
                  "y",
                  "scale_x",
                  "scale_y",
                  "rotation"
                ],
                "properties": {
                  "mode": {
                    "const": "manual_static_transform"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "scale_x": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 4
                  },
                  "scale_y": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 4
                  },
                  "rotation": {
                    "type": "number"
                  }
                },
                "description": "Existing manual static placement, independent scales and degree rotation; no anchors, arbitrary crop or tracking. Keep exact fields when retaining manual composition."
              },
              {
                "type": "null"
              }
            ]
          },
          "color": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "exposure",
                  "contrast",
                  "saturation"
                ],
                "properties": {
                  "exposure": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "contrast": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "saturation": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 3
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_ticks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "image"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "then": {
              "required": [
                "duration_ticks"
              ],
              "type": "object",
              "properties": {
                "duration_ticks": {}
              }
            },
            "else": {
              "not": {
                "required": [
                  "duration_ticks"
                ],
                "type": "object",
                "properties": {
                  "duration_ticks": {}
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audio_id",
          "shot_id",
          "source",
          "offset",
          "role",
          "gain_db",
          "fade_in",
          "fade_out",
          "purpose"
        ],
        "properties": {
          "audio_id": {
            "type": "string",
            "minLength": 1
          },
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "#/$defs/temporalSource"
          },
          "offset": {
            "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
          },
          "role": {
            "enum": [
              "dialogue",
              "music",
              "narration",
              "sfx"
            ]
          },
          "gain_db": {
            "type": "number",
            "minimum": -96,
            "maximum": 12
          },
          "fade_in": {
            "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
          },
          "fade_out": {
            "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caption_id",
          "shot_id",
          "offset",
          "duration",
          "text",
          "kind",
          "evidence_ids",
          "audio_anchor"
        ],
        "properties": {
          "caption_id": {
            "type": "string",
            "minLength": 1
          },
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
          },
          "duration": {
            "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "verbatim",
              "editorial",
              "manual_editorial"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "audio_anchor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "embedded",
                      "audio"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "manual_editorial"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            "then": {
              "properties": {
                "audio_anchor": {
                  "type": "null"
                }
              },
              "type": "object"
            },
            "else": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1,
                  "type": "array"
                }
              },
              "type": "object"
            }
          }
        ]
      }
    },
    "preserve_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "applied_principle_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "feedback_interpretation": {
      "type": "string",
      "minLength": 1
    },
    "change_summary": {
      "type": "string",
      "minLength": 1
    },
    "skill_effects": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definition_ref",
          "decision_path",
          "evidence_ids",
          "reason"
        ],
        "properties": {
          "definition_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_id",
              "object_version",
              "digest"
            ],
            "properties": {
              "object_id": {
                "type": "string",
                "minLength": 1
              },
              "object_version": {
                "type": "integer",
                "minimum": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "decision_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/(shots(?:/[0-9]+/(source_window|timing(?:/(kind|weight|duration_ticks))?|embedded_gain_db|reframe|color))?|audio(?:/[0-9]+(?:/(source|offset|gain_db|fade_in|fade_out|role))?)?|captions(?:/[0-9]+(?:/(text|offset|duration|style|audio_anchor))?)?)$"
          },
          "value_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Host-derived identity of the bound decision value. Models omit this field; a supplied false digest is rejected."
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "retained_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_timeline_version",
        "duration_ticks",
        "occupied_ticks",
        "placements"
      ],
      "properties": {
        "base_timeline_version": {
          "type": "integer",
          "minimum": 1
        },
        "duration_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "occupied_ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "placements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shot_id",
              "start_ticks",
              "duration_ticks"
            ],
            "properties": {
              "shot_id": {
                "type": "string",
                "minLength": 1
              },
              "start_ticks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "duration_ticks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "temporalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "start",
        "end",
        "span_id"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
        },
        "end": {
          "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json"
        },
        "span_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "imageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "asset_id",
        "span_id"
      ],
      "properties": {
        "kind": {
          "const": "image"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "span_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
