{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/creation-learning-event.v1.json",
  "title": "CreationLearningEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "event_id",
    "request_id",
    "actor_id",
    "data_type",
    "selection_json",
    "source_refs",
    "facts",
    "asset_ids",
    "requested_preserve_refs",
    "verified_unchanged_refs",
    "created_at",
    "correction_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "data_type": {
      "enum": [
        "feedback",
        "manual_diff",
        "selection",
        "history_reference"
      ]
    },
    "selection_json": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_ref_id",
          "object_type",
          "relation_key",
          "version",
          "digest"
        ],
        "properties": {
          "object_ref_id": {
            "type": "string",
            "minLength": 1
          },
          "object_type": {
            "enum": [
              "creation_session",
              "edit_ir",
              "timeline_snapshot",
              "creation_observation"
            ]
          },
          "relation_key": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "kind",
          "content",
          "source_ref_ids"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "user_statement",
              "timeline",
              "difference",
              "observation",
              "selection",
              "preservation"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "source_ref_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    },
    "asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requested_preserve_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "verified_unchanged_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "correction_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
