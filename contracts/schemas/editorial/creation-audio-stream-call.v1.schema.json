{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/creation-audio-stream-call.v1.json",
  "title": "CreationAudioStreamCallV1",
  "description": "Immutable reservation before one physical audio model send.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "call_id", "root_digest", "chunk_index", "chunk_digest", "sample_id", "attempt", "target", "wire_digest", "input_bytes", "dispatch_committed_at"],
  "properties": {
    "schema_version": { "const": 1 }, "call_id": { "type": "string", "minLength": 1 },
    "root_digest": { "$ref": "#/$defs/digest" }, "chunk_index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "chunk_digest": { "$ref": "#/$defs/digest" },
    "sample_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" }, "attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "target": { "type": "object", "additionalProperties": false, "required": ["role", "provider", "model", "endpoint", "digest"], "properties": { "role": { "enum": ["transcription", "sound"] }, "provider": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "endpoint": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } } },
    "wire_digest": { "$ref": "#/$defs/digest" }, "input_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "dispatch_committed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
