{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/editorial/timeline-annotation.v2.json",
  "title": "TimelineAnnotationV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "annotation_id", "anchor", "body"],
  "properties": {
    "schema_version": { "const": 2 },
    "annotation_id": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "anchor": { "$ref": "#/$defs/anchor" },
    "body": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" }
  },
  "$defs": {
    "preview_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "track_id", "clip_id", "start", "end", "preview_point"],
      "properties": {
        "surface": { "enum": ["timeline", "preview"] },
        "track_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "clip_id": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 200 },
            { "type": "null" }
          ]
        },
        "start": { "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json" },
        "end": {
          "anyOf": [
            { "$ref": "https://ai-vlog.local/contracts/common/rational-time.v1.json" },
            { "type": "null" }
          ]
        },
        "preview_point": {
          "anyOf": [
            { "$ref": "#/$defs/preview_point" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "surface": { "const": "preview" } }, "required": ["surface"] },
          "then": { "properties": { "preview_point": { "$ref": "#/$defs/preview_point" }, "end": { "type": "null" } } }
        },
        {
          "if": { "properties": { "surface": { "const": "timeline" } }, "required": ["surface"] },
          "then": { "properties": { "preview_point": { "type": "null" } } }
        }
      ]
    }
  }
}
