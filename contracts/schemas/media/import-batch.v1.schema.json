{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-vlog.local/contracts/media/import-batch.v1.json",
  "title": "MediaImportBatchV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "project_id", "actor_id", "idempotency_key", "revision", "status", "created_at", "updated_at", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["active", "completed", "partial", "stopped"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "stop_reason": {"$ref": "#/$defs/error"},
    "items": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_id", "source_ref_id", "display_name", "status", "attempt", "issues"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "source_ref_id": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 1024},
          "status": {"enum": ["waiting", "uploading", "validating", "imported", "duplicate", "failed", "cancelled"]},
          "attempt": {"type": "integer", "minimum": 1},
          "byte_length": {"type": "integer", "minimum": 0},
          "asset_id": {"type": "string", "pattern": "^asset:sha256:[0-9a-f]{64}$"},
          "asset_location_id": {"type": "string", "minLength": 1},
          "error": {"$ref": "#/$defs/error"},
          "compatibility_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "issues": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["attempt", "observed_at", "error"], "properties": {"attempt": {"type": "integer", "minimum": 1}, "observed_at": {"type": "string", "format": "date-time"}, "error": {"$ref": "#/$defs/error"}}}}
        },
        "allOf": [
          {"if": {"properties": {"status": {"enum": ["imported", "duplicate"]}}, "required": ["status"]}, "then": {"properties": {"asset_id": {}, "asset_location_id": {}}, "required": ["asset_id", "asset_location_id"]}},
          {"if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]}, "then": {"properties": {"error": {}}, "required": ["error"]}}
        ]
      }
    }
  },
  "$defs": {
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "recovery"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "recovery": {"enum": ["retry", "choose-source", "reopen-project", "free-space", "repair-storage", "check-permission"]}}}
  }
}
