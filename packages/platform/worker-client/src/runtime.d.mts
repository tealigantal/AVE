export type WorkerMessage = { type?: string; message_type?: string; request_id?: string; job_id?: string; [key: string]: unknown };
export type WorkerClientOptions = { command: string; args?: string[]; cwd?: string };
export type WorkerJobControl = { jobId?: string; signal?: AbortSignal; timeoutMs?: number; absoluteTimeoutMs?: number; onProgress?: (value: number) => void; onDiagnostic?: (value: unknown) => void; idempotent?: boolean };
export type WorkerResourceGate = { acquire(signal?: AbortSignal): Promise<() => void>; poison(error: Error): void };
export function assertWorkerMessage(value: unknown): asserts value is WorkerMessage;
export function startWorker(options: WorkerClientOptions): { child: { kill(): void }; messages: WorkerMessage[]; readonly stopped: boolean; readonly stderr: string; send(message: WorkerMessage): void; waitFor(requestId: string, timeoutMs?: number): Promise<WorkerMessage>; waitForMessage(predicate: (message: WorkerMessage) => boolean, timeoutMs?: number): Promise<WorkerMessage>; cancel(jobId: string): void; stop(): Promise<void> };
export function createPersistentWorkerClient(options: WorkerClientOptions): { readonly generation: number; readonly terminationUnconfirmed: boolean; readonly terminationFailure: Error | undefined; submit<TInput, TResult>(taskType: string, input: TInput, control?: WorkerJobControl): Promise<TResult>; close(): Promise<void> };
export function createLocalWorkerJobPort(options?: Partial<WorkerClientOptions> & { resourceGate?: WorkerResourceGate }): { readonly terminationUnconfirmed: boolean; readonly terminationFailure: Error | undefined; submit<TInput, TResult>(taskType: string, input: TInput, control?: WorkerJobControl): Promise<TResult>; close(): Promise<void> };
