{
  "name": "ai-vlog-co-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run architecture && npm run contracts:check && npm run contracts:compatibility && npm run storage:check && npm run project-api:boundary && npm run platform:foundation:test && npm run project-recovery:test && npm run dev-cli:test && npm run worker:analysis:test && npm run evidence:persistence:test && npm run evidence:host:test && npm run story-host:test && npm run assembly:host:test && npm run assembly:timeline:test && npm run rough-cut:host:test && npm run review-artifact:test && npm run reaction-host:test && npm run delivery:host:test && npm run export:host:test && npm run project-host:test && npm run timeline:host:test && npm run undo-redo:test && npm run render-service:test && npm run render-persistence:test",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "architecture": "node tools/architecture-check/check.mjs",
    "contracts:check": "node tools/contract-codegen/check.mjs",
    "contracts:compatibility": "node tools/contract-codegen/compatibility.mjs && npm run contracts:roundtrip",
    "contracts:generate": "node tools/contract-codegen/generate.mjs",
    "contracts:clean": "npm run contracts:generate && git diff --exit-code -- contracts/generated",
    "contracts:migrate-v0": "node tools/contract-codegen/migrate-v0.mjs",
    "contracts:roundtrip": "npm run contracts:generate && node tools/contract-codegen/roundtrip.mjs",
    "storage:check": "npm run storage:check:raw && npm run desktop:boundary",
    "storage:check:raw": "node packages/platform/project-storage/src/storage-smoke.mjs && node tests/integration/project-storage.test.mjs",
    "evidence:persistence:test": "node tests/integration/evidence-persistence.test.mjs",
    "project-host:test": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/integration/project-host.test.ts",
    "project-recovery:test": "node tests/integration/project-recovery.test.mjs",
    "dev-cli:test": "node tests/integration/dev-cli.test.mjs",
    "timeline:host:test": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/integration/timeline-host.test.ts",
    "undo-redo:test": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/integration/undo-redo.test.ts",
    "render-service:test": "node tests/integration/render-service.test.mjs",
    "render-persistence:test": "node tests/integration/render-persistence.test.mjs",
    "evidence:host:test": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/integration/evidence-host.test.ts",
    "story-host:test": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/integration/story-host.test.ts",
    "assembly:host:test": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/integration/assembly-host.test.ts",
    "assembly:timeline:test": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/integration/assembly-timeline.test.ts",
    "rough-cut:host:test": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/integration/rough-cut-host.test.ts",
    "review-artifact:test": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/integration/review-artifact.test.ts",
    "reaction-host:test": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/integration/reaction-host.test.ts",
    "delivery:host:test": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/integration/delivery-host.test.ts",
    "export:host:test": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/integration/export-host.test.ts",
    "media:fixture": "node tools/media-fixture-builder/create.mjs",
    "media:vfr": "node tools/media-fixture-builder/create-vfr.mjs",
    "media:probe": "node tools/media-fixture-builder/probe.mjs",
    "media:vfr:probe": "node tools/media-fixture-builder/probe-vfr.mjs",
    "media:render": "node tools/media-fixture-builder/render.mjs",
    "media:qc": "node tools/media-fixture-builder/qc.mjs",
    "edit-ir:test": "tsx tests/property/edit-ir.test.ts",
    "render-graph:test": "tsx tests/property/render-graph.test.ts",
    "editorial:test": "tsx tests/property/editorial-core.test.ts",
    "evidence:test": "tsx tests/property/evidence-sufficiency.test.ts",
    "coverage:test": "tsx tests/property/coverage-matrix.test.ts",
    "analysis:test": "tsx tests/property/analysis-evidence.test.ts",
    "story:test": "tsx tests/property/story-approval.test.ts",
    "assembly:test": "tsx tests/property/assembly-cut.test.ts",
    "assembly-compiler:test": "tsx tests/property/assembly-compiler.test.ts",
    "feedback:test": "tsx tests/property/feedback-diagnosis.test.ts",
    "compare:test": "tsx tests/property/compare-reaction.test.ts",
    "rough-cut:test": "tsx tests/property/rough-cut-patch.test.ts",
    "delivery:test": "tsx tests/property/delivery-gates.test.ts",
    "export:test": "tsx tests/property/export-registration.test.ts",
    "export:persistence:test": "node tests/integration/export-persistence.test.mjs",
    "export-capability:test": "tsx tests/property/export-capability.test.ts",
    "render:path:test": "node tests/integration/render-path.test.mjs",
    "qc:test": "node tests/integration/qc.test.mjs",
    "p0:acceptance": "tsx tests/integration/p0-acceptance.mjs",
    "desktop:boundary": "node tests/architecture/desktop-boundary.mjs",
    "project-api:boundary": "node tests/architecture/project-api-boundary.mjs",
    "platform:foundation:test": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/integration/platform-foundation.test.ts",
    "dev-cli:verify": "node --import tsx apps/dev-cli/src/main.ts verify-project .",
    "worker:analysis:test": "python apps/worker-host/tests/analysis_protocol_smoke.py"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "electron": "^43.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
